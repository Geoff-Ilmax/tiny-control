{
  // tiny-control camera control (acts on the selected camera), for the Quickshell Omarchy menu.
  // Merge these entries into ~/.config/omarchy/extensions/omarchy-menu.jsonc
  // (keep a single top-level object). Hot-reloads on save.
  "trigger.camera": {"icon":"󰖠","label":"Camera"},
  "trigger.camera.status":    {"icon":"","label":"Status","action":"omarchy-launch-or-focus-tui \"zsh -c 'tinyctl -c selected status; read -k 1'\""},
  "trigger.camera.sleep":     {"icon":"󰒲","label":"Sleep","action":"tinyctl -c selected sleep"},
  "trigger.camera.wake":      {"icon":"󰖨","label":"Wake","action":"tinyctl -c selected wake"},
  "trigger.camera.recenter":  {"icon":"󰑨","label":"Recenter gimbal","action":"tinyctl -c selected recenter"},
  "trigger.camera.track_on":  {"icon":"󰛐","label":"Tracking on","action":"tinyctl -c selected track on"},
  "trigger.camera.track_off": {"icon":"󰛑","label":"Tracking off","action":"tinyctl -c selected track off"},
  "trigger.camera.wb_pin":    {"icon":"󰔎","label":"Pin white balance","action":"tinyctl -c selected wb pin"},
  "trigger.camera.next":      {"icon":"󰄀","label":"Next camera","action":"tinyctl select next"},
  "trigger.camera.wb_auto":   {"icon":"󰖙","label":"Auto white balance","action":"tinyctl -c selected wb auto"},
}
