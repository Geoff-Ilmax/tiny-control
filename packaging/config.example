# tiny-control configuration.
# Install to ~/.config/tiny-control/config (per-user) or /etc/tiny-control/config
# (system-wide, used by the udev cold-plug hook running as root).
#
# Keys at the top apply to every camera. A [camera <ID>] section overrides them
# for one camera; <ID> is the serial shown by `tinyctl list`. tinyctl writes
# these sections for you (e.g. `tinyctl -c main wb temp 4500`), so you rarely
# need to edit this file by hand.

# Target white-balance temperature (Kelvin, 2000..10000) that tiny-guard
# re-pins to and that `tinyctl wb pin` uses. 4000K is a good baseline for a
# green-walled office where the camera's auto WB overcorrects.
wb_temp = 4000

# Persistent intent, updated by tinyctl and reloaded by the guard every second.
# auto: wake for video OR microphone capture. awake: keep awake until sleep.
# sleep: explicit privacy choice, overrides active calls until wake/auto.
power = auto
tracking = off
auto_wb = false
# HDR is left alone until explicitly configured.
# hdr = false

# Example per-camera overrides:
#
# [camera RMOWUHI3111PLN]
# alias = main
# wb_temp = 4500
# tracking = upper-body
#
# [camera RMOWXXXXXXXXXX]
# alias = overhead
# power = sleep
