# tiny-control — udev rules for OBSBOT Tiny 2 / Tiny 3 series cameras.
#
# Numbered 71- on purpose: the `uaccess` tag must be applied BEFORE
# 73-seat-late.rules (which turns the tag into the per-seat ACL). A 99- rule
# would tag too late and grant nothing.
#
# 1. Give the active-seat user access to each camera (uaccess) and its cdc_acm
#    control serial, plus a `video` group fallback for headless/multi-seat.
# 2. Cold-plug white-balance pin: UVC controls reset to firmware defaults on
#    unplug/power-cycle, and auto WB drowns in green-walled rooms. Re-pin
#    manual WB on plug-in. Setting a control (S_CTRL) does not start a stream.
#    `--device $devnode` identifies the camera by its serial, so each camera
#    gets its own target: the `[camera <serial>]` section's wb_temp in
#    /etc/tiny-control/config, else the global wb_temp, else 4000K.
#
#    The RUN path below assumes tinyctl is installed system-wide (/usr/bin, the
#    AUR layout). For a ~/.local/bin install, packaging/install-root.sh rewrites
#    this path to the real one. If tinyctl is not on a path root can execute,
#    drop the RUN+= lines — tiny-guard still handles the stream-open case.
#
# NOTE: installing this rule does nothing for an already-plugged camera. Replug,
# or: udevadm control --reload-rules && udevadm trigger --action=add --subsystem-match=video4linux
#
# Supported product IDs (Remo Tech, vendor 3564):
#   fef8 = OBSBOT Tiny 2
#   ff02 = OBSBOT Tiny 3
#   ff04 = OBSBOT Tiny 3 Lite (verified)
# Another model? Add a line per PID below (see CONTRIBUTING.md).

ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="fef8", ATTR{index}=="0", TAG+="uaccess", GROUP="video", MODE="0660", RUN+="/usr/bin/tinyctl --device $devnode wb pin"
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="ff02", ATTR{index}=="0", TAG+="uaccess", GROUP="video", MODE="0660", RUN+="/usr/bin/tinyctl --device $devnode wb pin"
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="ff04", ATTR{index}=="0", TAG+="uaccess", GROUP="video", MODE="0660", RUN+="/usr/bin/tinyctl --device $devnode wb pin"

# The cdc_acm control serial (if a future transport uses it) — seat + group access.
SUBSYSTEM=="tty", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="fef8|ff02|ff04", TAG+="uaccess", GROUP="uucp", MODE="0660"
