[Unit]
Description=OBSBOT call microphone (noise and speaker echo reduction)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart=/usr/bin/pipewire -c %h/.config/tiny-control/tiny-audio.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
