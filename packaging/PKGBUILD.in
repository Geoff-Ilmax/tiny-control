# Maintainer: Geoff-Ilmax (forked from obsbot-tiny3-linux by Josh Lambert)
#
# TEMPLATE. The release workflow renders this into the real PKGBUILD for each
# tag: @PKGVER@ becomes the version and @SHA256@ the sha256 of that release's
# source tarball. The rendered file is published as a release asset and
# committed back to packaging/PKGBUILD — never edit that copy by hand.
pkgname=tiny-control
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Linux control suite for the OBSBOT Tiny 3 series webcam (sleep/wake, AI tracking, gimbal, white balance)"
arch=('x86_64' 'aarch64')
url="https://github.com/Geoff-Ilmax/tiny-control"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=('v4l-utils: manual UVC control inspection')
backup=('etc/tiny-control/config')
# Pinned to the release asset we publish and checksum ourselves, not to
# GitHub's auto-generated /archive/ tarball (which GitHub can regenerate).
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --frozen
}

package() {
    cd "$pkgname-$pkgver"

    install -Dm755 target/release/tinyctl "$pkgdir/usr/bin/tinyctl"
    install -Dm755 target/release/tiny-guard "$pkgdir/usr/bin/tiny-guard"
    install -Dm755 target/release/tiny-remote "$pkgdir/usr/bin/tiny-remote"
    install -Dm755 bin/tiny-preview "$pkgdir/usr/bin/tiny-preview"

    # Per-user systemd unit (enable with: systemctl --user enable --now tiny-guard)
    install -Dm644 packaging/systemd/tiny-guard.service \
        "$pkgdir/usr/lib/systemd/user/tiny-guard.service"
    # OBSBOT Tiny Smart Remote (enable with: systemctl --user enable --now tiny-remote)
    install -Dm644 packaging/systemd/tiny-remote.service \
        "$pkgdir/usr/lib/systemd/user/tiny-remote.service"

    # udev: group access + cold-plug WB pin
    install -Dm644 packaging/udev/71-tiny-control.rules \
        "$pkgdir/usr/lib/udev/rules.d/71-tiny-control.rules"

    # Default system config (used by the root/udev context); marked as backup.
    install -Dm644 packaging/config.example "$pkgdir/etc/tiny-control/config"

    # Example Hyprland keybindings + preview window rule (user copies what they want)
    install -Dm644 packaging/hypr/tiny-control.conf \
        "$pkgdir/usr/share/tiny-control/hypr/tiny-control.conf"
    install -Dm644 packaging/hypr/bindings.omarchy.lua \
        "$pkgdir/usr/share/tiny-control/hypr/bindings.omarchy.lua"
    install -Dm644 packaging/hypr/windows.omarchy.lua \
        "$pkgdir/usr/share/tiny-control/hypr/windows.omarchy.lua"

    # Omarchy menu snippet (the bar WIDGET is a separate repo / marketplace
    # listing: https://github.com/Geoff-Ilmax/omarchy-tiny-control)
    install -Dm644 packaging/omarchy-menu.jsonc \
        "$pkgdir/usr/share/tiny-control/omarchy/omarchy-menu.jsonc"

    # Docs
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 PROTOCOL.md "$pkgdir/usr/share/doc/$pkgname/PROTOCOL.md"
    install -Dm644 packaging/config.example \
        "$pkgdir/usr/share/doc/$pkgname/config.example"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
